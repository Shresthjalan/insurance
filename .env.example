# Application
NODE_ENV=development
PORT=5100
LOG_LEVEL=info
REQUEST_TIMEOUT_MS=30000
# Public-facing URL of this server — used to build PDF download links sent over WhatsApp
# In dev: http://localhost:5100  |  In prod: https://your-domain.com
PUBLIC_BASE_URL=http://localhost:5100

# Database (Supabase)
# Project URL, from Supabase project settings → API
SUPABASE_URL=https://[project-ref].supabase.co
# Service role secret key — server-side only, bypasses Row Level Security. NEVER expose to a client.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Redis (BullMQ queues)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Telenow Webhook Auth
TELENOW_API_KEY=your-telenow-api-key-here
TELENOW_WEBHOOK_SECRET=your-telenow-webhook-secret-here

# WhatsApp (Meta)
WHATSAPP_VERIFY_TOKEN=your-whatsapp-verify-token
WHATSAPP_APP_SECRET=your-whatsapp-app-secret
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_API_VERSION=v18.0
WHATSAPP_API_BASE_URL=https://graph.facebook.com

# Quotation Providers
# Leave these EMPTY to use built-in stub quotes (demo mode — no real API calls).
# Set both URL and KEY when you have real insurer API credentials.
PROVIDER_A_API_URL=https://api.provider-a.com/v1
PROVIDER_A_API_KEY=
PROVIDER_B_API_URL=https://api.provider-b.com/v1
PROVIDER_B_API_KEY=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Queue Concurrency
QUOTATION_WORKER_CONCURRENCY=5
WHATSAPP_WORKER_CONCURRENCY=10
NOTIFICATION_WORKER_CONCURRENCY=5

# WhatsApp Session Expiry
WHATSAPP_SESSION_TTL_HOURS=24
